{
  "name": "nexxa-waitlist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1 \"server/tests/**/*.test.js\"",
    "migrate": "node --env-file-if-exists=.env server/scripts/migrate-json-to-mongo.js",
    "backfill": "node --env-file-if-exists=.env server/scripts/backfill-referrals.js",
    "prices": "node --env-file-if-exists=.env server/scripts/update-prices.js",
    "prices:demo": "cross-env PRICE_SOURCE=demo node --env-file=.env.test server/scripts/update-prices.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongodb": "^6.21.0",
    "mongoose": "^9.11.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "supertest": "^7.3.1",
    "vite": "^5.4.11"
  }
}
