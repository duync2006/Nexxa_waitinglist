# Sao chép thành .env và đổi giá trị trước khi chạy docker compose
MONGO_ROOT_USER=nexxa
MONGO_ROOT_PASSWORD=doi-mat-khau-manh-o-day
MONGODB_DB=nexxa_waitlist

# Chuỗi kết nối cho server Node. BẮT BUỘC — thiếu biến này server sẽ báo lỗi và thoát.
MONGODB_URI=mongodb://nexxa:doi-mat-khau-manh-o-day@localhost:27018/nexxa_waitlist?authSource=admin

# .env.test — tạo file riêng cho `npm test`. Tên database BẮT BUỘC kết thúc bằng _test,
# vì test xoá sạch collection sau mỗi ca; helpers/db.js sẽ từ chối chạy nếu không đúng.
# MONGODB_URI=mongodb://nexxa:doi-mat-khau-manh-o-day@localhost:27018/nexxa_waitlist_test?authSource=admin
# MONGODB_DB=nexxa_waitlist_test

# Nguồn giá cổ phiếu cho màn hình Reserve. Điền phần gọi API vào
# server/services/price-source.js, rồi chạy `npm run prices` để nạp snapshot.
#
# Chưa có nhà cung cấp? Dùng giá demo: `npm run prices:demo` (PRICE_SOURCE=demo).
# Giá demo là số bịa và script TỪ CHỐI ghi vào database không kết thúc bằng _test.
# PRICE_SOURCE_NAME=ten-nha-cung-cap
# PRICE_API_URL=https://...
# PRICE_API_KEY=
