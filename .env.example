# Sao chép thành .env và đổi giá trị trước khi chạy docker compose
MONGO_ROOT_USER=nexxa
MONGO_ROOT_PASSWORD=doi-mat-khau-manh-o-day
MONGODB_DB=nexxa_waitlist

# Chuỗi kết nối cho server Node. BẮT BUỘC — thiếu biến này server sẽ báo lỗi và thoát.
MONGODB_URI=mongodb://nexxa:doi-mat-khau-manh-o-day@localhost:27018/nexxa_waitlist?authSource=admin

# .env.test — tạo file riêng cho `npm test`. Tên database BẮT BUỘC kết thúc bằng _test,
# vì test xoá sạch collection sau mỗi ca; helpers/db.js sẽ từ chối chạy nếu không đúng.
# MONGODB_URI=mongodb://nexxa:doi-mat-khau-manh-o-day@localhost:27018/nexxa_waitlist_test?authSource=admin
# MONGODB_DB=nexxa_waitlist_test

# Nguồn giá cổ phiếu cho màn hình Reserve. `npm run prices` gọi:
#   POST <PRICE_API_URL>   header x-api-key: <PRICE_API_KEY>
#   body     { "symbols": ["ACB", "BID", ...] }   — lấy từ shared/catalog.js
#   response { "data": [{ "symbol": "ACB", "price": 20500 }], "notFound": [] }
#
# Chưa có nhà cung cấp? Dùng giá demo: `npm run prices:demo` (PRICE_SOURCE=demo).
# Giá demo là số bịa và script TỪ CHỐI ghi vào database không kết thúc bằng _test.
PRICE_SOURCE_NAME=nexxa-stock-api
PRICE_API_URL=https://nexxa.asia/stock/api/v1/get-prices
PRICE_API_KEY=dien-khoa-cua-ban-o-day

# Đồng hồ campaign Top 1.000. Cả ba đều TUỲ CHỌN và phải là ISO 8601 CÓ múi giờ
# (ví dụ 2027-01-01T00:00:00+07:00) — thiếu múi giờ hay sai định dạng thì server từ chối khởi động.
#   TOP_START       — lúc mở campaign, chỉ dùng để vẽ cung đếm ngược trên trang.
#   TOP_DEADLINE    — hết giờ đua Top: ngừng cộng lượt mời, giỏ bị khoá (423) cho tới khi chạy
#                     `npm run finalize`. Thiếu biến này thì không chặn gì, Top tính theo hạng hiện tại.
#   REPICK_DEADLINE — hạn chọn lại giỏ sau finalize; quá hạn thì giỏ khoá hẳn. Phải sau TOP_DEADLINE.
# TOP_START=2026-12-01T00:00:00+07:00
# TOP_DEADLINE=2027-01-01T00:00:00+07:00
# REPICK_DEADLINE=2027-01-08T00:00:00+07:00
